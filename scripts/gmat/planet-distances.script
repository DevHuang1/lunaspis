% Planet-center distances derived from GMAT DE405 at a fixed UTC epoch.
Create Spacecraft Probe;
Probe.DateFormat = UTCGregorian;
Probe.Epoch = '14 Nov 2026 00:00:00.000';
Probe.CoordinateSystem = EarthMJ2000Eq;
Probe.X = 7000;
Probe.Y = 0;
Probe.Z = 0;
Probe.VX = 0;
Probe.VY = 7.5;
Probe.VZ = 0;
Create CoordinateSystem MercuryFrame;
MercuryFrame.Origin = Mercury;
MercuryFrame.Axes = MJ2000Eq;
Create CoordinateSystem VenusFrame;
VenusFrame.Origin = Venus;
VenusFrame.Axes = MJ2000Eq;
Create CoordinateSystem MarsFrame;
MarsFrame.Origin = Mars;
MarsFrame.Axes = MJ2000Eq;
Create CoordinateSystem JupiterFrame;
JupiterFrame.Origin = Jupiter;
JupiterFrame.Axes = MJ2000Eq;
Create CoordinateSystem SaturnFrame;
SaturnFrame.Origin = Saturn;
SaturnFrame.Axes = MJ2000Eq;
Create CoordinateSystem UranusFrame;
UranusFrame.Origin = Uranus;
UranusFrame.Axes = MJ2000Eq;
Create CoordinateSystem NeptuneFrame;
NeptuneFrame.Origin = Neptune;
NeptuneFrame.Axes = MJ2000Eq;
Create Variable dx dy dz MercuryDistance VenusDistance MarsDistance JupiterDistance SaturnDistance UranusDistance NeptuneDistance;
Create ReportFile report;
report.Filename = 'planet-distances.txt';
report.WriteHeaders = true;
BeginMissionSequence;
dx = Probe.MercuryFrame.X - Probe.EarthMJ2000Eq.X;
dy = Probe.MercuryFrame.Y - Probe.EarthMJ2000Eq.Y;
dz = Probe.MercuryFrame.Z - Probe.EarthMJ2000Eq.Z;
MercuryDistance = sqrt(dx^2 + dy^2 + dz^2);
dx = Probe.VenusFrame.X - Probe.EarthMJ2000Eq.X;
dy = Probe.VenusFrame.Y - Probe.EarthMJ2000Eq.Y;
dz = Probe.VenusFrame.Z - Probe.EarthMJ2000Eq.Z;
VenusDistance = sqrt(dx^2 + dy^2 + dz^2);
dx = Probe.MarsFrame.X - Probe.EarthMJ2000Eq.X;
dy = Probe.MarsFrame.Y - Probe.EarthMJ2000Eq.Y;
dz = Probe.MarsFrame.Z - Probe.EarthMJ2000Eq.Z;
MarsDistance = sqrt(dx^2 + dy^2 + dz^2);
dx = Probe.JupiterFrame.X - Probe.EarthMJ2000Eq.X;
dy = Probe.JupiterFrame.Y - Probe.EarthMJ2000Eq.Y;
dz = Probe.JupiterFrame.Z - Probe.EarthMJ2000Eq.Z;
JupiterDistance = sqrt(dx^2 + dy^2 + dz^2);
dx = Probe.SaturnFrame.X - Probe.EarthMJ2000Eq.X;
dy = Probe.SaturnFrame.Y - Probe.EarthMJ2000Eq.Y;
dz = Probe.SaturnFrame.Z - Probe.EarthMJ2000Eq.Z;
SaturnDistance = sqrt(dx^2 + dy^2 + dz^2);
dx = Probe.UranusFrame.X - Probe.EarthMJ2000Eq.X;
dy = Probe.UranusFrame.Y - Probe.EarthMJ2000Eq.Y;
dz = Probe.UranusFrame.Z - Probe.EarthMJ2000Eq.Z;
UranusDistance = sqrt(dx^2 + dy^2 + dz^2);
dx = Probe.NeptuneFrame.X - Probe.EarthMJ2000Eq.X;
dy = Probe.NeptuneFrame.Y - Probe.EarthMJ2000Eq.Y;
dz = Probe.NeptuneFrame.Z - Probe.EarthMJ2000Eq.Z;
NeptuneDistance = sqrt(dx^2 + dy^2 + dz^2);
Report report Probe.UTCGregorian MercuryDistance VenusDistance MarsDistance JupiterDistance SaturnDistance UranusDistance NeptuneDistance;
