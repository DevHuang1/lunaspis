% Illustrative co-planar phasing rendezvous, using an ISS-like circular orbit.
% Two-body Earth gravity; this is a training scenario, not an ISS ephemeris.
Create Spacecraft Station Craft;
Station.DateFormat = UTCGregorian;
Station.Epoch = '01 Jan 2026 00:00:00.000';
Station.CoordinateSystem = EarthMJ2000Eq;
Station.DisplayStateType = Keplerian;
Station.SMA = 6778.1363;
Station.ECC = 0.000001;
Station.INC = 51.6;
Station.RAAN = 0;
Station.AOP = 0;
Station.TA = 0;
Craft.DateFormat = UTCGregorian;
Craft.Epoch = '01 Jan 2026 00:00:00.000';
Craft.CoordinateSystem = EarthMJ2000Eq;
Craft.DisplayStateType = Keplerian;
Craft.SMA = 6778.1363;
Craft.ECC = 0.000001;
Craft.INC = 51.6;
Craft.RAAN = 0;
Craft.AOP = 0;
Craft.TA = 345;
Create ForceModel EarthModel;
EarthModel.CentralBody = Earth;
EarthModel.PointMasses = {Earth};
Create Propagator OrbitProp;
OrbitProp.FM = EarthModel;
OrbitProp.Type = PrinceDormand78;
OrbitProp.InitialStepSize = 10;
OrbitProp.Accuracy = 1e-12;
Create ImpulsiveBurn PhaseBurn;
PhaseBurn.CoordinateSystem = Local;
PhaseBurn.Origin = Earth;
PhaseBurn.Axes = VNB;
PhaseBurn.Element1 = -0.013365263265;
Create ImpulsiveBurn MatchBurn;
MatchBurn.CoordinateSystem = Local;
MatchBurn.Origin = Earth;
MatchBurn.Axes = VNB;
MatchBurn.Element1 = 0.013365263265;
Create EphemerisFile StationOutput;
StationOutput.Spacecraft = Station;
StationOutput.Filename = 'iss-training-station.oem';
StationOutput.FileFormat = CCSDS-OEM;
StationOutput.CoordinateSystem = EarthMJ2000Eq;
StationOutput.StepSize = 30;
Create EphemerisFile CraftOutput;
CraftOutput.Spacecraft = Craft;
CraftOutput.Filename = 'iss-training-craft.oem';
CraftOutput.FileFormat = CCSDS-OEM;
CraftOutput.CoordinateSystem = EarthMJ2000Eq;
CraftOutput.StepSize = 30;
BeginMissionSequence;
Maneuver PhaseBurn(Craft);
Propagate OrbitProp(Station, Craft) {Craft.ElapsedSecs = 44197.8948633};
Maneuver MatchBurn(Craft);
